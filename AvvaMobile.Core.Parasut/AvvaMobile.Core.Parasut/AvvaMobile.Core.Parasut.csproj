<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Avva Mobile Paraşüt</Title>
		<Authors>Avva Mobile Enterprise Solutions</Authors>
		<Description>Paraşüt API ile kolay ve hızlı çalışmak için hazırlanmış paket.</Description>
		<PackageProjectUrl>https://github.com/AvvaMobile/AvvaMobile.Core.Parasut</PackageProjectUrl>
		<PackageIcon>avvamobile.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) 2022-2026 Avva Mobile Enterprise Solutions</Copyright>
		<RepositoryUrl>https://github.com/AvvaMobile/AvvaMobile.Core.Parasut</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>avvamobile;parasut;</PackageTags>
		<NeutralLanguage>tr</NeutralLanguage>
		<RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
		<RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
		<EnableNETAnalyzers>False</EnableNETAnalyzers>
		<Version>2.0.2</Version>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<!-- Sembol paketi ve kaynak kodu bağlantısı: paketin içine adım adım debug edilebilsin. -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<ItemGroup>
		<None Include="avvamobile.png" Pack="True" PackagePath="\">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\..\README.md" Pack="True" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
	</ItemGroup>
</Project>
